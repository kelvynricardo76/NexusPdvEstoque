# Nexus PDV & Estoque — variáveis de ambiente (exemplo SEM segredos reais).
# Copie para .env (ignorado pelo git) e preencha.

# Perfil Spring: dev (H2 local + dados de demonstração) ou prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---------- Desenvolvimento ----------
NEXUS_H2_PATH=./data/nexus-dev
# Senha dos usuários de demonstração criados pelo seed (somente perfil dev)
NEXUS_DEV_PASSWORD=
NEXUS_DEV_SEED=true

# ---------- Produção ----------
NEXUS_DB_URL=
NEXUS_DB_USER=
NEXUS_DB_PASSWORD=
NEXUS_DB_POOL_SIZE=10
NEXUS_FRONTEND_URL=https://app.seudominio.com.br
# Origens permitidas via CORS (vazio = mesma origem, recomendado)
NEXUS_CORS_ALLOWED_ORIGINS=
NEXUS_SECURE_COOKIES=true

# Primeiro SUPER_ADMIN (criado apenas se não existir nenhum administrador da plataforma)
NEXUS_BOOTSTRAP_ADMIN_NAME=Administrador Nexus
NEXUS_BOOTSTRAP_ADMIN_EMAIL=
NEXUS_BOOTSTRAP_ADMIN_PASSWORD=
